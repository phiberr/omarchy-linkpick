{
  "manifest_version": 3,
  "name": "Omarchy LinkSheet",
  "version": "0.2.0",
  "description": "Route external links from Chromium/Chrome app windows through Omarchy LinkSheet",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "windows"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background-2.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-2.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
