#!/usr/bin/env bash
# xdg-open wrapper: route http(s) through omarchy-linkpick, everything else
# to the real /usr/bin/xdg-open. Avoid recursion via OMARCHY_LINKPICK_WRAP.

set -euo pipefail

REAL_XDG_OPEN=/usr/bin/xdg-open
HELPER="${HOME}/.local/bin/omarchy-linkpick"
[[ -x $HELPER ]] || HELPER="$(command -v omarchy-linkpick || true)"

if [[ ${OMARCHY_LINKPICK_WRAP:-} == 1 ]]; then
  exec "$REAL_XDG_OPEN" "$@"
fi

is_url() {
  local s="$1"
  [[ $s =~ ^[Hh][Tt][Tt][Pp][Ss]?:// ]] && return 0
  # An existing local path stays a file for the real xdg-open, even if its
  # name looks like a domain (notes.md, report.pdf, ...).
  [[ -e $s ]] && return 1
  [[ $s =~ ^[[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,}(/.*)?$ ]] && return 0
  return 1
}

if [[ -n ${HELPER:-} && -x $HELPER ]]; then
  for arg in "$@"; do
    case "$arg" in
      -*) continue ;;
    esac
    if is_url "$arg"; then
      export OMARCHY_LINKPICK_WRAP=1
      exec "$HELPER" open "$arg"
    fi
  done
fi

exec "$REAL_XDG_OPEN" "$@"
